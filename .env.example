DATABASE_URL=sqlite:///finreview.db
LOG_LEVEL=INFO
AUTH_SECRET_KEY=
# Required: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENROUTER_API_KEY=
AI_MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_MODEL_NAME=google/gemma-3-27b-it:free
NEWS_API_KEY=
MARKET_DATA_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional broker features. Ordinary Community CSV/sample research needs no broker.
# Keep these false on public demos. The historical API uses deployment credentials.
FINREVIEW_V2_MARKET_API_ENABLED=false
FINREVIEW_V2_OAUTH_ENABLED=false
FINREVIEW_V2_BROKER_PROBES_ENABLED=false

# Private backend adapters. These settings do not add broker controls to Research Lab.
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
# FinReview reads this slot for the Upstox LTP adapter. Use a quote-authorized token.
UPSTOX_ACCESS_TOKEN=
# Historical data and LTP require a data-enabled Kite Connect account.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# FYERS individual-app OAuth on the maintainer's allowlisted staging deployment only.
# Set FINREVIEW_ENV=staging and opt in to OAuth and probes only for that deployment.
FINREVIEW_ENV=
FINREVIEW_FYERS_TEST_USER_ID=
FYERS_APP_SECRET=
# Exact registered HTTPS API callback ending in /v2/market/oauth/fyers/callback.
# The OAuth success return currently targets the maintainer's staging frontend.
FINREVIEW_FYERS_REDIRECT_URI=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINREVIEW_BROKER_VAULT_KEY=
# Independent random secret for profile probes. Generate separately from the auth secret.
FINREVIEW_BROKER_IDENTITY_HMAC_KEY=

# Public multi-user FYERS OAuth requires a FYERS third-party app and an HTTPS
# deployment with OAuth callback query-string logging disabled or redacted.
# Use the third-party FYERS_CLIENT_ID and FYERS_APP_SECRET, the registered
# FINREVIEW_FYERS_REDIRECT_URI, and the independent encrypted vault key above.
FINREVIEW_FYERS_THIRD_PARTY_ENABLED=false
# Trusted HTTPS Research Lab URL, ending in /intelligence.html.
FINREVIEW_FYERS_FRONTEND_RETURN_URL=
